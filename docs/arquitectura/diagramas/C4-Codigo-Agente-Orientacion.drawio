<mxCell id="title" value="C4 — Código del orquestador conversacional" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontColor=#0F172A;fontSize=30;" vertex="1" parent="1"><mxGeometry x="40" y="25" width="1660" height="45" as="geometry"/></mxCell>
<mxCell id="sub" value="Agente / API FastAPI / componente de aplicación / ChatService · Diseño propuesto para implementar y revisar con Solangie" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontColor=#0F172A;fontSize=17;" vertex="1" parent="1"><mxGeometry x="40" y="80" width="1660" height="35" as="geometry"/></mxCell>
<mxCell id="request" value="&lt;b&gt;DATOS · Pydantic&lt;/b&gt;&lt;br&gt;&lt;b&gt;ChatRequest&lt;/b&gt;&lt;hr&gt;message: str&lt;br&gt;session_token: str" style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=12;fillColor=#E0F2FE;strokeColor=#075985;strokeWidth=2;fontColor=#0F172A;fontSize=14;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="40" y="170" width="310" height="145" as="geometry"/></mxCell>
<mxCell id="response" value="&lt;b&gt;DATOS · Pydantic&lt;/b&gt;&lt;br&gt;&lt;b&gt;ChatResponse&lt;/b&gt;&lt;hr&gt;answer: str&lt;br&gt;resource_ids: list[str]&lt;br&gt;request_id: str" style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=12;fillColor=#E0F2FE;strokeColor=#075985;strokeWidth=2;fontColor=#0F172A;fontSize=14;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="40" y="385" width="310" height="150" as="geometry"/></mxCell>
<mxCell id="service" value="&lt;b&gt;APLICACIÓN · orquestador&lt;/b&gt;&lt;br&gt;&lt;b&gt;ChatService&lt;/b&gt;&lt;hr&gt;__init__(sessions, recommender,&lt;br&gt;    llm, policy)&lt;br&gt;async reply(request: ChatRequest)&lt;br&gt;    -&amp;gt; ChatResponse&lt;br&gt;Coordina un turno; inyección&lt;br&gt;de dependencias por constructor." style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=12;fillColor=#DBEAFE;strokeColor=#1E40AF;strokeWidth=2;fontColor=#0F172A;fontSize=14;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="430" y="230" width="360" height="280" as="geometry"/></mxCell>
<mxCell id="policy" value="&lt;b&gt;DOMINIO · reglas comprobables&lt;/b&gt;&lt;br&gt;&lt;b&gt;InteractionPolicy&lt;/b&gt;&lt;hr&gt;validate_input(message: str) -&amp;gt; str&lt;br&gt;validate_output(answer: str) -&amp;gt; str&lt;br&gt;Comprueba alcance educativo y salida." style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=12;fillColor=#FEF3C7;strokeColor=#92400E;strokeWidth=2;fontColor=#0F172A;fontSize=14;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="430" y="640" width="360" height="165" as="geometry"/></mxCell>
<mxCell id="session" value="&lt;b&gt;PUERTO · typing.Protocol&lt;/b&gt;&lt;br&gt;&lt;b&gt;SessionStore&lt;/b&gt;&lt;hr&gt;async get(token: str) -&amp;gt; ChatContext&lt;br&gt;async save(context: ChatContext) -&amp;gt; None&lt;br&gt;async expire(token: str) -&amp;gt; None" style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=12;fillColor=#EDE9FE;strokeColor=#5B21B6;strokeWidth=2;fontColor=#0F172A;fontSize=14;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="880" y="160" width="350" height="160" as="geometry"/></mxCell>
<mxCell id="memory" value="&lt;b&gt;ADAPTADOR · memoria temporal&lt;/b&gt;&lt;br&gt;&lt;b&gt;InMemorySessionStore&lt;/b&gt;&lt;hr&gt;async get(token: str) -&amp;gt; ChatContext&lt;br&gt;async save(context: ChatContext) -&amp;gt; None&lt;br&gt;async expire(token: str) -&amp;gt; None" style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=12;fillColor=#D1FAE5;strokeColor=#065F46;strokeWidth=2;fontColor=#0F172A;fontSize=14;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="1340" y="160" width="350" height="160" as="geometry"/></mxCell>
<mxCell id="llm" value="&lt;b&gt;PUERTO · typing.Protocol&lt;/b&gt;&lt;br&gt;&lt;b&gt;LLMClient&lt;/b&gt;&lt;hr&gt;async generate(context: ChatContext)&lt;br&gt;    -&amp;gt; str&lt;br&gt;Contexto mínimo permitido." style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=12;fillColor=#EDE9FE;strokeColor=#5B21B6;strokeWidth=2;fontColor=#0F172A;fontSize=14;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="880" y="410" width="350" height="145" as="geometry"/></mxCell>
<mxCell id="provider" value="&lt;b&gt;ADAPTADOR · proveedor externo&lt;/b&gt;&lt;br&gt;&lt;b&gt;ProviderLLMClient&lt;/b&gt;&lt;hr&gt;async generate(context: ChatContext)&lt;br&gt;    -&amp;gt; str&lt;br&gt;Gestiona API, timeout y errores." style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=12;fillColor=#D1FAE5;strokeColor=#065F46;strokeWidth=2;fontColor=#0F172A;fontSize=14;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="1340" y="410" width="350" height="145" as="geometry"/></mxCell>
<mxCell id="recommend" value="&lt;b&gt;DOMINIO · selección determinista&lt;/b&gt;&lt;br&gt;&lt;b&gt;RecommendationService&lt;/b&gt;&lt;hr&gt;__init__(catalog: CatalogRepository)&lt;br&gt;async recommend(profile: CompetencyProfile)&lt;br&gt;    -&amp;gt; list[Resource]" style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=12;fillColor=#FEF3C7;strokeColor=#92400E;strokeWidth=2;fontColor=#0F172A;fontSize=14;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="880" y="650" width="350" height="155" as="geometry"/></mxCell>
<mxCell id="catalog" value="&lt;b&gt;PUERTO · typing.Protocol&lt;/b&gt;&lt;br&gt;&lt;b&gt;CatalogRepository&lt;/b&gt;&lt;hr&gt;async find_by_competencies(ids: list[str])&lt;br&gt;    -&amp;gt; list[Resource]&lt;br&gt;Catálogo curado de recursos." style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=12;fillColor=#EDE9FE;strokeColor=#5B21B6;strokeWidth=2;fontColor=#0F172A;fontSize=14;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="880" y="920" width="350" height="150" as="geometry"/></mxCell>
