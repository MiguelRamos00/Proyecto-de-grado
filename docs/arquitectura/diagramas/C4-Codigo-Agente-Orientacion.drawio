<mxCell id="types" value="&lt;b&gt;TIPOS DE DOMINIO · dataclasses propuestas&lt;/b&gt;&lt;br&gt;&lt;b&gt;ChatContext · CompetencyProfile · Resource&lt;/b&gt;&lt;hr&gt;ChatContext: session_token, profile, history, resources&lt;br&gt;CompetencyProfile: competency_ids, levels&lt;br&gt;Resource: id, title, url, competency_ids" style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=12;fillColor=#F1F5F9;strokeColor=#334155;strokeWidth=2;fontColor=#0F172A;fontSize=14;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="40" y="920" width="710" height="150" as="geometry"/></mxCell>
